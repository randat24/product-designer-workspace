# Copy to .env.local for local development; in Vercel set the same names in
# Project → Settings → Environment Variables. No spaces around "=" and no quotes.

# Supabase — Project Settings → API (`npx supabase status` for the local stack).
# The anon/publishable key is public by design (it is shipped to the browser; RLS protects the data).
# Never put the service_role key in a NEXT_PUBLIC_* variable or in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical public origin, no trailing slash: canonical URLs, hreflang, sitemap, robots, Open Graph,
# JSON-LD and auth email links. Set it to the final custom domain once it is connected.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Loaded on the public site in production only.
NEXT_PUBLIC_GA_ID=

# "on" shows "Войти через Google" (enable the provider in Supabase first)
NEXT_PUBLIC_AUTH_GOOGLE=

# Self-hosted production only (not Vercel): allow indexing. On Vercel, production is detected
# automatically and previews are always noindex.
# SITE_INDEXABLE=true
